# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/travel_buddy

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Anthropic Claude AI (required for /api/chat and /api/generate-plan)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenWeatherMap API — free tier at https://openweathermap.org/api
# Used for /api/weather/<city> and /api/forecast/<city>
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# OpenTripMap API — free tier at https://opentripmap.io
# Used for /api/hotels/<city> and /api/places/<city>
OPENTRIPMAP_API_KEY=your-opentripmap-api-key-here

# Exchange rates are fetched from open.er-api.com (no key required)
# Google Maps API (optional — for future map embed)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
