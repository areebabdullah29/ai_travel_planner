# Copy this to .env and fill in your values

# Backend API URL (Flask server handles all API keys — keep them server-side)
VITE_API_URL=http://localhost:5000

# Google Maps API key — enable: Maps JavaScript API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Claude API key is now used server-side only (backend/.env)
# VITE_ANTHROPIC_API_KEY is no longer needed
